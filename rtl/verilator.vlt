`verilator_config

// The project's control file for Verilator, which every Verilator build and
// lint run reads: lint waivers, coverage exclusions, and the internal signals
// that tests access (builds make only the top level's ports accessible). See
// "Verilator Control Files" in Verilator's manual. (A comment that starts with
// the word "verilator" would be read as a metacomment.)

// Covergroups, and uses of the std package such as its process and semaphore
// classes, make Verilator compile its own verilated_std.sv: keep it out of the
// coverage reports, which are for the design.
coverage_off -file "*/verilated_std.sv"

// Third-party RTL is compiled as delivered, so it is not linted.
lint_off -file "*/rtl/vendor/*"
